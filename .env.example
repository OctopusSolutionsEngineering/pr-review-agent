# ===== LLM =====
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2

# ===== GitHub =====
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your-random-secret

# ===== Key Vault (optional) =====
USE_KEY_VAULT=false
AZURE_KEY_VAULT_URL=

# ===== App =====
LOG_LEVEL=INFO
MAX_ITERATIONS=15
MAX_DIFF_CHARS=30000

# ===== Safety =====
ALLOWED_REPOS=                  # Comma-separated, empty = all
REQUIRE_LABEL=                  # e.g., "ai-review"
DEFAULT_DRY_RUN=false

# ===== Caching =====
CACHE_BACKEND=memory            # 'memory' or 'redis'
REDIS_URL=redis://localhost:6379/0
CACHE_MAX_SIZE=1000
CACHE_TTL_PR_METADATA=300
CACHE_TTL_PR_DIFF=600
CACHE_TTL_PR_FILES=600
CACHE_TTL_FILE_CONTENT=3600
ENABLE_TOOL_CACHE=true
