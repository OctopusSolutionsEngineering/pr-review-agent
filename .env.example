# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# GitHub
# Create at: https://github.com/settings/tokens (need 'repo' scope)
# Or use a fine-grained token / GitHub App for production
GITHUB_TOKEN=ghp_your_token_here

# Webhook secret (any random string — set the same in GitHub webhook settings)
GITHUB_WEBHOOK_SECRET=your-random-secret-here
